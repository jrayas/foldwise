{
  "name": "foldwise",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Route pasted files to per-folder asset folders and manage saved assets in Obsidian.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench.mjs",
    "vault:create": "node scripts/vault-create.mjs",
    "vault:synthetic": "node scripts/vault-synthetic.mjs",
    "debug:launch": "node scripts/obsidian-launch.mjs",
    "debug": "node scripts/debug.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
